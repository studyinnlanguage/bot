<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/splash_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="@color/gold"
            android:textSize="30sp"
            android:letterSpacing="0.18"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/tagline"
            android:textColor="@color/dim"
            android:textSize="12.5sp"
            android:letterSpacing="0.22" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BOT SERVER URL"
                android:textColor="@color/gold"
                android:textSize="11sp"
                android:letterSpacing="0.16"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/url"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:hint="@string/server_hint"
                android:textColorHint="@color/dim"
                android:textColor="@color/txt"
                android:textSize="14sp"
                android:inputType="textUri"
                android:imeOptions="actionGo"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:maxLines="1" />

            <CheckBox
                android:id="@+id/trust_ssl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/trust_ssl"
                android:textColor="@color/dim"
                android:textSize="12.5sp"
                android:buttonTint="@color/gold" />

            <Button
                android:id="@+id/connect"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_gold"
                android:text="@string/connect"
                android:textColor="#0A0908"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/status_ready"
                android:textColor="@color/dim"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Open your bot dashboard once in a browser to confirm the URL, then paste it here. Saved for next time."
            android:textColor="@color/dim"
            android:textSize="11.5sp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
