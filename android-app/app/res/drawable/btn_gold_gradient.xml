<?xml version="1.0" encoding="utf-8"?>
<!-- Concept CTA: bright WEE-XIONIC yellow gradient (mockup buttons) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFE8B70A" android:centerColor="#FFDDAE06" android:endColor="#FFC99400" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF4A4110" android:centerColor="#FF3D3610" android:endColor="#FF302B0E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFDD55" android:centerColor="#FFF5C518" android:endColor="#FFE0AC05" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
