<?xml version="1.0" encoding="utf-8"?>
<!-- Concept aurora hero: deep-space base + gold/blue radial glows (concept mockup style) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF10161F"
                android:centerColor="#FF0B0F16"
                android:endColor="#FF07090D" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="220dp"
                android:centerX="0.85"
                android:centerY="0.05"
                android:startColor="#33F0B90B"
                android:endColor="#000F0B0B" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="200dp"
                android:centerX="0.05"
                android:centerY="0.95"
                android:startColor="#333949AB"
                android:endColor="#0007090D" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
