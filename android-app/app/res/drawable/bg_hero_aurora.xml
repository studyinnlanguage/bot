<?xml version="1.0" encoding="utf-8"?>
<!-- WEE-XIONIC concept hero: warm black base + single bright gold bloom,
     exactly like the mockup's Total Equity card. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF15130C"
                android:centerColor="#FF0E0D09"
                android:endColor="#FF080807" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="230dp"
                android:centerX="0.88"
                android:centerY="0.0"
                android:startColor="#3DF5C518"
                android:endColor="#00080807" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="190dp"
                android:centerX="0.0"
                android:centerY="1.0"
                android:startColor="#26B3882A"
                android:endColor="#00080807" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#FF3A3320" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
