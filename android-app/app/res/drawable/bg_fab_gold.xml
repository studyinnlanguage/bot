<?xml version="1.0" encoding="utf-8"?>
<!-- Concept bottom-nav FAB: bright yellow circle + dark ring, soft glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#26F5C518" />
        </shape>
    </item>
    <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:startColor="#FFFFDD55"
                android:centerColor="#FFF5C518"
                android:endColor="#FFDDAE06"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#FF4A3E10" />
        </shape>
    </item>
</layer-list>
